// {{ ansible_managed }}
// Local overrides; the distribution's 50unattended-upgrades keeps the
// default (security) origins.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ linux_hardening_unattended_upgrades_remove_unused | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot "{{ linux_hardening_unattended_upgrades_reboot | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ linux_hardening_unattended_upgrades_reboot_time }}";
{% if linux_hardening_unattended_upgrades_mail %}
Unattended-Upgrade::Mail "{{ linux_hardening_unattended_upgrades_mail }}";
Unattended-Upgrade::MailReport "on-change";
{% endif %}
Unattended-Upgrade::SyslogEnable "true";
